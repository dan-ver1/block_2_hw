# Скопіюйте цей файл у .env і заповніть значення. Файл .env не додається в Git.

# PostgreSQL (навчальна база, доступ лише на читання)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Розкоментуйте, якщо сервер вимагає SSL:
# PGSSLMODE=require

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
